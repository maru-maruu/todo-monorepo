    "hono": "^4.7.7",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/uuid": "^11.0.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.14.0"
  }
